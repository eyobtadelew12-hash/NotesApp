<?xml version="1.0" encoding="utf-8"?>
<!--
  Developer settings: F5 works against your local LocalDB database
  (create it with scripts\setup\Setup-LocalDb.ps1).
  Deployed environments never use these values: Web.Release.config turns them
  into #{tokens}# and the release fills them in per environment.
-->
<configuration>
  <connectionStrings>
    <add name="NotesDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=NotesApp;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Environment" value="Local" />
    <add key="ReleaseVersion" value="dev" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="RemoteOnly" />
  </system.web>
</configuration>
