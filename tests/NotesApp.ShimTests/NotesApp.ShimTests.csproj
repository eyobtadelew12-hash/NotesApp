<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Microsoft Fakes (shims) tests for legacy code that reads DateTime.Now directly.
    Fakes needs Visual Studio ENTERPRISE, so this project is NOT in NotesApp.sln:
    CI builds and runs it on GitHub's Windows runners (which have Enterprise).
    The workflow passes FakesAssemblyPath.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NotesApp.Core\NotesApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.QualityTools.Testing.Fakes">
      <HintPath>$(FakesAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Fakes Include="Fakes\mscorlib.fakes" />
  </ItemGroup>
</Project>
